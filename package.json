{
  "name": "sign-o-matic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Print-ready shelf signs for 47x70mm holders. Local web app + CLI.",
  "bin": {
    "signo": "./bin/signo.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/server/index.ts",
    "signo": "tsx src/cli/index.ts",
    "seed:logos": "tsx scripts/make-fake-logos.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/carlito": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@pdf-lib/fontkit": "^1.1.1",
    "hono": "^4.13.16",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
